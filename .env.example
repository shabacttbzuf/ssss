# Lovable Cloud auto-injects these at runtime — no manual .env needed.
# Listed here for reference / self-hosting only.

# Client-side (browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side (TanStack server functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
